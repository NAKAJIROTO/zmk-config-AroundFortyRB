#include "AroundForty-RB.dtsi"
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    col-gpios
        = <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&xiao_d  9 GPIO_ACTIVE_HIGH>
        , <&xiao_d  8 GPIO_ACTIVE_HIGH>
        , <&xiao_d  7 GPIO_ACTIVE_HIGH>
        , <&gpio0 10 GPIO_ACTIVE_HIGH>
        ;
};

/* --- ここに zip_temp_layer の設定を追加 --- */
&zip_temp_layer {
    require-prior-idle-ms = <200>;
};

/ {
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;

        input-processors =
            <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT)>,

            /* 通常カーソルをかなり鈍く */
            <&zip_xy_scaler 1 1>,

            /* 【変更】キーを離してから200ms以上経っている時だけ、
               トラックボール操作でレイヤー5へ切り替える（維持時間は10秒） */
            <&zip_temp_layer 5 10000>;
    };

    /* もしレイヤー5用のスクロール設定にするなら、ここも 5 に合わせます */
    scroll_layer {
        layers = <5>;

        input-processors =
            <&zip_xy_transform
                (INPUT_TRANSFORM_Y_INVERT |
                 INPUT_TRANSFORM_X_INVERT)>,

            <&zip_xy_to_scroll_mapper>,

            /* スクロール誤爆防止 */
            <&zip_scroll_scaler 1 80>;
    };
};

/* --- 以下、&pinctrl や &spi0 などの記述はそのまま継続 --- */
