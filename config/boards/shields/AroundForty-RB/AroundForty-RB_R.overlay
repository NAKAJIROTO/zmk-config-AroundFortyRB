#include "AroundForty-RB.dtsi"

#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/input_transform.h>

#include <input/processors.dtsi>

#include <zephyr/dt-bindings/input/input-event-codes.h>

/* =========================
 * Matrix
 * ========================= */

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    col-gpios
        = <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&xiao_d  9 GPIO_ACTIVE_HIGH>
        , <&xiao_d  8 GPIO_ACTIVE_HIGH>
        , <&xiao_d  7 GPIO_ACTIVE_HIGH>
        , <&gpio0 10 GPIO_ACTIVE_HIGH>
        ;
};

/* =========================
 * Hold Tap
 * ========================= */

&mt {
    flavor = "balanced";
    tapping-term-ms = <180>;
    quick-tap-ms = <0>;
    require-prior-idle-ms = <150>;
};

/ {
    behaviors {
        ls: layer_space {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            flavor = "balanced";

            tapping-term-ms = <180>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <150>;

            bindings = <&mo>, <&kp>;
        };
    };
};

/* =========================
 * Trackball temp layer
 * ========================= */

&zip_temp_layer {
    require-prior-idle-ms = <200>;
};

/ {
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";

        device = <&pmw3610>;

        input-processors =
            /* X反転 */
            <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT)>,

            /* 通常カーソルをかなり低速化 */
            <&zip_xy_scaler 1 1>,

            /*
             * トラックボール操作時だけ
             * 一時的にレイヤー5へ
             */
            <&zip_temp_layer 5 10000>;
    };

    /*
     * Layer5 = Scroll mode
     */
    scroll_layer {
        layers = <5>;

        input-processors =
            <&zip_xy_transform
                (INPUT_TRANSFORM_Y_INVERT |
                 INPUT_TRANSFORM_X_INVERT)>,

            <&zip_xy_to_scroll_mapper>,

            /* スクロールをかなり鈍く */
            <&zip_scroll_scaler 1 80>;
    };
};

/* =========================
 * SPI Pin Control
 * ========================= */

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels =
                <NRF_PSEL(SPIM_SCK,  0, 6)>,
                <NRF_PSEL(SPIM_MOSI, 0, 26)>,
                <NRF_PSEL(SPIM_MISO, 0, 28)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels =
                <NRF_PSEL(SPIM_SCK,  0, 6)>,
                <NRF_PSEL(SPIM_MOSI, 0, 26)>,
                <NRF_PSEL(SPIM_MISO, 0, 28)>;

            low-power-enable;
        };
    };
};

/* =========================
 * PMW3610
 * ========================= */

&spi0 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";

    cs-gpios = <&gpio0 29 GPIO_ACTIVE_LOW>;

    pmw3610: pmw3610@0 {
        compatible = "pixart,pmw3610";

        reg = <0>;

        spi-max-frequency = <2000000>;

        irq-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;

        evt-type = <INPUT_EV_REL>;

        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;

        swap-xy;
    };
};
