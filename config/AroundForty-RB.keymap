#include <behaviors/rgbled_widget.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    tapping-term-ms = <150>;
    quick-tap-ms = <120>;
    require-prior-idle-ms = <70>;
};

/ {
    combos {
        compatible = "zmk,combos";

        Escape {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        RIGHT1 {
            bindings = <&kp RIGHT_ARROW>;
            key-positions = <17 8>;
        };

        BS {
            bindings = <&kp BACKSPACE>;
            key-positions = <16 7>;
        };

        KANA {
            bindings = <&kp LA(GRAVE)>;
            key-positions = <3 4>;
        };

        CAPSS {
            bindings = <&kp CAPS>;
            key-positions = <13 14>;
        };

        MO1 {
            bindings = <&to 1>;
            key-positions = <5 6>;
            layers = <0>;
        };

        MO0 {
            bindings = <&to 0>;
            key-positions = <5 6>;
            layers = <1>;
        };

        DELL {
            bindings = <&kp DELETE>;
            key-positions = <9 8>;
        };

        BM1 {
            bindings = <&mb1_click>;
            key-positions = <17 18>;
            timeout-ms = <30>;
            require-prior-idle-ms = <100>;
        };

        BM2 {
            bindings = <&mb2_click>;
            key-positions = <18 19>;
            timeout-ms = <30>;
            require-prior-idle-ms = <100>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        oo: OO {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_0 &kp NUMBER_0>;
            label = "OO";
        };

        entent: ENTENT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ENTER &kp ENTER &kp ENTER &kp ENTER &kp ENTER &kp ENTER &kp ENTER>;
            label = "ENTENT";
        };

        cal: cal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(NUMBER_1)>;
            label = "CAL";
        };

        sum: sum {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(S)) &kp U &kp M>;
            label = "SUM";
        };

        jp_kakko: jp_kakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LBKT) &kp LS(RBKT) &kp LEFT>;
        };

        mb1_click: mb1_click {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mkp MB1>;
        };

        mb2_click: mb2_click {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mkp MB2>;
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // 

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Default {
            display-name = "0";
            bindings = <
&kp Q      &kp W     &kp E          &kp R                &kp T                     &kp Y        &kp U  &kp I       &kp O    &kp P
&kp A      &kp S     &kp D          &kp F                &kp G                     &kp H        &kp J  &kp K       &kp L    &kp MINUS
&kp Z      &kp X     &kp C          &kp V                &kp B        &mo 5        &kp N        &kp M  &mkp MB1    &mo 5    &mkp MB2
&kp LSHFT  &kp LGUI  &mt LALT DOWN  &mt LCTRL BACKSPACE  &lt 2 SPACE  &lt 1 ENTER  &lt 1 ENTER  &mo 5  &lt 3 DOWN  &kp TAB  &kp LS(TAB)
            >;
        };

        NUM {
            display-name = "1";
            bindings = <
&kp EQUAL  &kp KP_PLUS  &kp KP_MINUS  &kp KP_MULTIPLY  &kp KP_DIVIDE                 &kp N7  &kp N8  &kp N9      &kp N0  &kp KP_SLASH
&entent    &kp LEFT     &kp UP        &kp RIGHT        &kp F9                        &kp N4  &kp N5  &kp N6      &oo     &trans
&kp LC(F)  &cal         &kp LC(C)     &kp LC(V)        &kp LC(SINGLE_QUOTE)  &trans  &kp N1  &kp N2  &kp N3      &trans  &trans
&trans     &trans       &trans        &trans           &trans                &trans  &trans  &trans  &lt 5 DOWN  &trans  &trans
            >;
        };

        FUNCTION {
            display-name = "2";
            bindings = <
&kp AT_SIGN  &kp UNDERSCORE  &kp EXCLAMATION       &kp QUESTION          &kp DOLLAR                     &kp F1            &kp F2         &kp F3     &kp F4     &kp F5
&kp PERCENT  &kp HASH        &kp AMPERSAND         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS          &kp F6            &kp F7         &kp F8     &kp F9     &kp F10
&kp HASH     &kp PIPE        &kp NON_US_BACKSLASH  &kp SINGLE_QUOTE      &kp DOUBLE_QUOTES      &trans  &kp LEFT_BRACKET  &kp SEMICOLON  &kp COLON  &kp COMMA  &kp DOT
&trans       &trans          &trans                &trans                &trans                 &trans  &trans            &trans         &trans     &trans     &trans
            >;
        };

        ARROW {
            display-name = "3";
            bindings = <
&sum    &kp PRINTSCREEN  &trans  &trans  &trans          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans  &trans  &trans
&trans  &trans           &trans  &trans  &trans          &kp LEFT_BRACE    &kp RIGHT_BRACE    &trans  &trans  &trans
&trans  &trans           &trans  &trans  &trans  &trans  &kp LS(COMMA)     &kp LS(DOT)        &trans  &trans  &trans
&trans  &trans           &trans  &trans  &trans  &trans  &trans            &trans             &trans  &trans  &trans
            >;
        };

        MOUSE {
            display-name = "4";
            bindings = <
&trans  &trans  &trans    &trans    &trans          &trans  &trans  &trans    &trans  &trans
&trans  &trans  &mkp MB1  &mkp MB2  &trans          &trans  &trans  &trans    &trans  &trans
&trans  &trans  &trans    &trans    &trans  &trans  &trans  &trans  &mkp MB1  &trans  &trans
&trans  &trans  &trans    &trans    &trans  &trans  &trans  &trans  &trans    &trans  &trans
            >;
        };

        SCROLL {
            display-name = "5";
            bindings = <
&trans       &trans  &trans  &trans  &trans          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &trans
&trans       &trans  &trans  &trans  &trans          &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR    &trans  &trans
&trans       &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans  &trans
&bootloader  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans  &bootloader
            >;
        };
    };
};

#define ZMK_MOUSE_DEFAULT_MOVE_VAL 400
#define U_MOUSE_MOVE_EXPONENT 1
#define U_MOUSE_MOVE_TIME 600
#define U_MOUSE_MOVE_DELAY 0
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 25
#define U_MOUSE_SCROLL_EXPONENT 1
#define U_MOUSE_SCROLL_TIME 1200
#define U_MOUSE_SCROLL_DELAY 0
#define U_MOUSE_SCROLL_DELAY 0
