#include <behaviors/rgbled_widget.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    tapping-term-ms = <150>;
    quick-tap-ms = <120>;
    require-prior-idle-ms = <70>;
};

/ {
    combos {
        compatible = "zmk,combos";

        Escape {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        RIGHT1 {
            bindings = <&kp BACKSPACE>;
            key-positions = <17 8>;
        };

        BS {
            bindings = <&kp BACKSPACE>;
            key-positions = <16 7>;
        };

        KANA {
            bindings = <&kp LA(GRAVE)>;
            key-positions = <3 4>;
        };

        CAPSS {
            bindings = <&kp CAPS>;
            key-positions = <13 14>;
        };

        MO1 {
            bindings = <&to 1>;
            key-positions = <5 6>;
            layers = <0>;
        };

        MO0 {
            bindings = <&to 0>;
            key-positions = <5 6>;
            layers = <1>;
        };

        hiiii {
            bindings = <&kp A>;
            key-positions = <28 18 9>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        oo: OO {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_0 &kp NUMBER_0>;
            label = "OO";
        };

        entent: ENTENT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ENTER &kp ENTER &kp ENTER &kp ENTER &kp ENTER &kp ENTER &kp ENTER>;
            label = "ENTENT";
        };

        cal: cal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(NUMBER_1)>;
            label = "CAL";
        };

        sum: sum {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(S)) &kp U &kp M>;
            label = "SUM";
        };

        jp_kakko: jp_kakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LBKT) &kp LS(RBKT) &kp LEFT>;
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // 

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Default {
            display-name = "0";
            bindings = <
&kp Q      &kp W         &kp E              &kp R                       &kp T                     &kp Y        &kp U  &kp I       &kp O     &kp P
&kp A      &kp S         &kp D              &kp F                       &kp G                     &kp H        &kp J  &kp K       &kp L     &kp MINUS
&kp Z      &kp X         &kp C              &kp V                       &kp B        &mo 5        &kp N        &kp M  &mkp MB1    &mkp MB2  &mo 5
&kp LSHFT  &kp LEFT_GUI  &mt LEFT_ALT DOWN  &mt LEFT_CONTROL BACKSPACE  &lt 2 SPACE  &lt 1 ENTER  &lt 1 ENTER  &mo 5  &lt 3 DOWN  &kp TAB   &kp LS(TAB)
            >;
        };

        NUM {
            display-name = "1";
            bindings = <
&kp EQUAL  &kp KP_PLUS  &kp KP_MINUS  &kp KP_ASTERISK  &kp KP_DIVIDE                 &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &kp KP_SLASH
&entent    &kp LEFT     &kp UP        &kp RIGHT        &kp F9                        &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &oo           &trans
&kp LC(F)  &cal         &kp LC(C)     &kp LC(V)        &kp LC(SINGLE_QUOTE)  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans        &trans
&trans     &trans       &trans        &trans           &trans                &trans  &trans        &trans        &lt 5 DOWN    &trans        &trans
            >;
        };

        FUNCTION {
            display-name = "2";
            bindings = <
&kp AT_SIGN   &kp UNDERSCORE  &kp EXCLAMATION       &kp HASH              &kp DOLLAR                     &kp F1            &kp F2    &kp F3     &kp F4     &kp F5
&kp PERCENT   &kp QUESTION    &kp AMPERSAND         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS          &kp F6            &kp F7    &kp F8     &kp F9     &kp F10
&kp ASTERISK  &kp PIPE        &kp NON_US_BACKSLASH  &kp SQT               &kp DOUBLE_QUOTES      &trans  &kp LEFT_BRACKET  &kp SEMI  &kp COLON  &kp COMMA  &kp DOT
&trans        &trans          &trans                &trans                &trans                 &trans  &trans            &trans    &trans     &trans     &trans
            >;
        };

        ARROW {
            display-name = "3";
            bindings = <
&sum    &kp PRINTSCREEN  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans           &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans           &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans           &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans    &trans    &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans  &mkp MB1  &mkp MB2  &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans    &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans    &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        SCROLL {
            bindings = <
&trans       &trans  &trans  &trans  &trans          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &trans
&trans       &trans  &trans  &trans  &trans          &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR    &trans  &trans
&trans       &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans  &trans
&bootloader  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans  &bootloader
            >;
        };
    };
};

#define ZMK_MOUSE_DEFAULT_MOVE_VAL 400
#define U_MOUSE_MOVE_EXPONENT 1
#define U_MOUSE_MOVE_TIME 600
#define U_MOUSE_MOVE_DELAY 0
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 25
#define U_MOUSE_SCROLL_EXPONENT 1
#define U_MOUSE_SCROLL_TIME 4500
#define U_MOUSE_SCROLL_DELAY 0
